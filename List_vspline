#
# src/vspline/List_vspline
# For building, linking, linting with VSPLINE Library.
#
# VS_ are expected for internal use only, VSPLINE_ are for external
# This expects VSPLINE_SRC, src_def, and LIB0_DIR to be defined

VS_SRC_OPTIMA=$(VSPLINE_SRC)/optima
VS_SRC_IODEP =$(VSPLINE_SRC)/matrix
VS_SRC_MATRIX=$(VSPLINE_SRC)/matrix
VS_SRC_SMOOTH=$(VSPLINE_SRC)/smooth
VS_SRC_NONLIN=$(VSPLINE_SRC)/nonlin

VS_LIB_OPTIMA=$(LIB0_DIR)/libVoptima.a
VS_LIB_IODEP= $(LIB0_DIR)/libViodep.a
VS_LIB_MATRIX=$(LIB0_DIR)/libVmatrix.a
VS_LIB_SMOOTH=$(LIB0_DIR)/libVsmooth.a
VS_LIB_NONLIN=$(LIB0_DIR)/libVnonlin.a
VSPLINE_LIBS=	\
	$(VS_LIB_SMOOTH) $(VS_LIB_OPTIMA) $(VS_LIB_MATRIX) \
	$(VS_LIB_IODEP)
#	$(VS_LIB_NONLIN) 
#VLIBS=-L$(LIB) -lVnonlin -lVsmooth -lVoptima -lVmatrix -lViodep

PREC=Double
VSPLINE_INCS= -D$(PREC)Prec -I$(VSPLINE_SRC) -I$(src_def) \
	-I$(VS_SRC_MATRIX) -I$(VS_SRC_SMOOTH) -I$(VS_SRC_NONLIN)
LFLAGS=-u $(incs)

VS_H_OPTIMA = \
	$(VSPLINE_SRC)/defs-env.h \
	$(VSPLINE_SRC)/defs-vspline.h \
	$(VS_SRC_MATRIX)/defs_vmatrix.h
VS_H_MATRIX = \
	$(VSPLINE_SRC)/defs-env.h \
	$(VSPLINE_SRC)/defs-vspline.h \
	$(VS_SRC_MATRIX)/defs_vmatrix.h \
	$(VS_SRC_MATRIX)/mexdep.h
VS_H_SMOOTH=$(VS_H_MATRIX) \
	$(VS_SRC_SMOOTH)/smooth.h $(VS_SRC_SMOOTH)/decs-smooth.h
VS_H_NONLIN=$(VS_H_SMOOTH) $(VS_SRC_NONLIN)/nonlin.h

#
# All .h files
#
