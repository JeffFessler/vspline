#!/bin/csh -e
#	Data/README
#	This directory contains sample input files and the resulting output.
#	They were generated by executing this script with SUFFIX=out.
#	I recommend that you set SUFFIX=out2 and then execute this script
#	(type "source README" should do it), and then compare the results.

set SUFFIX=out2 

if 1 then
	echo 1
	test_vs 0 0	< data1 > data1_vs.$SUFFIX
	echo 2
	test_vs 0 0	< data2 > data2_vs.$SUFFIX
	echo 3
	test_vs 0 0 2	< data1 > data1_bs.$SUFFIX
	echo 4
	test_vs 0 0	< data3i > data3i_vs.$SUFFIX
	echo 5
	test_vs 0 1	< data3 > data3_vs.$SUFFIX
	echo 6
	test_ss 2	< data4 > data4_ss.$SUFFIX
	echo 7
	test_ci 7 241	< data5 > data5_ci.$SUFFIX
endif

if 0 then
	diff data1_vs.out*
	diff data2_vs.out*
	diff data1_bs.out*	# not exactly the same, but close
	diff data3i_vs.out*
	diff data3_vs.out*
	diff data4_ss.out*
endif
	diff data5_ci.out*
